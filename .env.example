# Copy this file to .env and fill in whatever optional features you want. Everything here is
# optional -- leave a section commented out and that feature just doesn't render.

# --- Unread-mail widget (read-only IMAP) ---
# Password must be a Google "app password" (requires 2FA), generated at
# https://myaccount.google.com/apppasswords -- never your real account password.
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# Add more accounts with _2, _3, ... (numbering must stay contiguous from 1):
# GMAIL_ADDRESS_2=you2@gmail.com
# GMAIL_APP_PASSWORD_2=your-16-char-app-password

# --- Downloads widget (optional, points at a separate self-hosted downloads dashboard) ---
# IG_DASHBOARD_URL=http://localhost:3011

# --- Server ---
# PORT=3015
